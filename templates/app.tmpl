from dataclasses import dataclass
from typing import (Annotated, Optional)
import typer
from basern.stack import (get_func_name_with_sys, StackDump)

# /// script
# dependencies = [
#    "typer",
# ]
# ///

# remove the completion related help text
# , "ignore_unknown_options": True
app = typer.Typer(help="blah",
                  add_completion=False, rich_markup_mode="markdown",
                  context_settings={"help_option_names": ["-h", "--help", "-?"],
                                    "allow_extra_args": True,
                                    "ignore_unknown_options": True, }
                  )

class Klass:
  @dataclass
  class KlassCfg:
    verbosity: int = 0

    def dump(self, message:str="") -> str:
      fn:str = get_func_name_with_sys(StackDump.CALLER) + "-"
      msg_str = fn + f"{message}-" if len(message or "") > 0 else ""
      ret_str: str = f"{msg_str}DUMP: "
      ret_str = ret_str + "verbosity={self.verbosity}, "
      return ret_str

  # --- Main Command ---
  @staticmethod
  @app.command()
  def entry_point(ctx: typer.Context,
            some_str: Annotated[str, typer.Option("--message", "-m", "-q", show_default=False, help="something",)]=None,
            dflt_yn: Annotated[YN_Values, typer.Option("-d", "-default", "--default", 
                                                          help="YES OR NO enum values")] = YN_Values.NO,
    
            verbosity: Annotated[int, typer.Option("-v", count=True, show_default=True,
                                                   help="Set verbosity level. Allows -vvv for more verbosity")] = 0,
            vlevel: Annotated[int, typer.Option("--verbosity", "-vrb", show_default=False,
                                                help="Specify a verbosity level, 1=warning, 2=info,3=debug etc.")] = 0,
  ) -> None:
    if vlevel>0:
      verbosity=vlevel

    fn:str = f"{get_func_name_with_sys(StackDump.CURRENT_METHOD)} -" if verbosity>0 else ""

    # prepare config
    cfg: Klass.KlassCfg = Klass.KlassCfg(verbosity=verbosity)

    # prepare and setup other configurations
    print(f"{cfg.dump(f"ENTRY args={ctx.args}")}")

    # supply config into context, if there are other commands!
    ctx.obj = cfg

    kk: Klass = Klass()
    kk.biz_logic(cfg, ctx.args)

  def bix_logic(self, cfg: Klass.KlassCfg, args: list[str] = None):
    print(f"{cfg.dump(f"args={args}")}")
    # comment or delete 2 lines
    typer.secho("WIP see source", fg=typer.colors.RED, bg=typer.colors.WHITE, bold=True)
    sys.exit(123)



#
# Entry point into the script!
#
if __name__ == "__main__":
    app()
